# 构建阶段
FROM docker.io/golang:1.24-alpine AS builder

# 设置工作目录
WORKDIR /app

# 复制 go.mod 和 go.sum
COPY go.mod go.sum ./

# 下载依赖
RUN go mod download

# 复制源代码
COPY . .

# 构建 e2e 测试二进制文件
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o e2e-test ./test/e2e

# 运行阶段
FROM docker.io/alpine:latest

# 安装必要的工具
RUN apk --no-cache add ca-certificates

# 创建非root用户
RUN adduser -D -s /bin/sh e2e-user

# 设置工作目录
WORKDIR /home/e2e-user

# 从构建阶段复制二进制文件
COPY --from=builder /app/e2e-test .

# 更改所有权
RUN chown e2e-user:e2e-user e2e-test

# 切换到非root用户
USER e2e-user

# 暴露端口
EXPOSE 10022

# 设置入口点
ENTRYPOINT ["./e2e-test"]

# 设置标签
LABEL org.opencontainers.image.title="sshole-e2e-test"
LABEL org.opencontainers.image.description="E2E test for sshole project"
LABEL org.opencontainers.image.source="https://github.com/your-repo/sshole"
